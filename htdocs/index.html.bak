<!-- the graph goes here -->
<div class="gallery" id="chart" style=" position:relative;"><div id="gpu-layer" style="position:absolute; inset:0; z-index:1; pointer-events:none; display:none; /* hidden by default */"></div>
<div class="menu-top">
<div class="menu-left">
<div class="btn-group">
<button class="btn btn-primary" data-bind="click: showAdd">Add Molecule</button>
<button aria-expanded="false" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
<span class="caret"></span>
<span class="sr-only">Toggle Dropdown</span>
</button>
<ul class="dropdown-menu" role="menu">
<li role="presentation"><a data-bind="click: showAdd">Add Sequence and Secondary Structure</a></li>
<li role="presentation"><a data-bind="click: showAddPDB">Add PDB File</a></li>
<li role="presentation"><a data-bind="click: showAddMMCIF">Add MMCIF File</a></li>
<li role="presentation"><a data-bind="click: showAddJSON">Add JSON File</a></li>
</ul>
</div>
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="right" data-toggle="tooltip" title="Delete everyting">
<button class="btn btn-default" data-bind="click: clearGraph">Clear</button>
</div>
</div>
<div class="menu-right">
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="bottom" data-toggle="tooltip" id="About" title="About">
<button class="btn btn-default" data-bind="click: showAbout"><span class="glyphicon glyphicon-question-sign"></span></button>
</div>
</div>
</div>
<div class="menu-bottom">
<div class="menu-left">
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="top" data-toggle="tooltip" title="Animation (Key: Space)">
<input class="bootstrap-switch" data-bind="bootstrapSwitchOn: animation" name="animation-toggle" type="checkbox"/>
</div>
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="top" data-toggle="tooltip" title="Center molecules (Key: C)">
<button class="btn btn-default" data-bind="click: centerMolecules"><span class="glyphicon glyphicon-screenshot"></span></button>
</div>
<div class="btn-group dropup">
<button aria-expanded="false" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button">
            Colors <span class="caret"> </span>
<span class="sr-only">Toggle Dropdown</span>
</button>
<ul class="dropdown-menu menu-form" role="menu">
<li class="dropdown-header" role="presentation">Color Scheme</li>
<li data-bind="css: { active: colors() === 'positions' }" role="presentation">
<label role="menuitem">
<input data-bind="checked: colors, checkedValue: 'positions'" name="colors" type="radio"/> Positions
              </label>
<li>
<li data-bind="css: { active: colors() === 'structure' }" role="presentation">
<label role="menuitem">
<input data-bind="checked: colors, checkedValue: 'structure'" name="colors" type="radio"/> Structure
              </label>
</li>
<li data-bind="css: { active: colors() === 'sequence' }" role="presentation">
<label role="menuitem">
<input data-bind="checked: colors, checkedValue: 'sequence'" name="colors" type="radio"/> Sequence
              </label>
</li>
<li data-bind="css: { active: colors() === 'custom' }" role="presentation">
<label role="menuitem">
<input data-bind="checked: colors, checkedValue: 'custom', checkedVaue: 'custom'" name="colors" type="radio"/> Custom 
                <button data-bind="click: showCustomColors, attr: { 'class': colors() === 'custom' ? 'btn btn-xs btn-default' : 'btn btn-xs btn-primary' }" role="menuitem" type="button">Set</button>
</label>
</li>
</li></li></ul>
</div>
<div class="btn-group dropup">
<button aria-expanded="false" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button">
<span class="glyphicon glyphicon-cog"> </span>
<span class="caret"></span>
<span class="sr-only">Toggle Dropdown</span>
</button>
<ul class="dropdown-menu menu-form" role="menu">
<li class="dropdown-header" role="presentation">Display Options</li>
<li data-bind="css: {active: numbering}" role="presentation">
<label role="menuitem">
<input data-bind="checked: numbering" type="checkbox"/> Sequence numbering
                </label>
</li>
<li data-bind="css: {active: nodeLabel}" role="presentation">
<label role="menuitem">
<input data-bind="checked: nodeLabel" type="checkbox"/> Nucleotide label
                </label>
</li>
<li data-bind="css: {active: nodeOutline}" role="presentation">
<label role="menuitem">
<input data-bind="checked: nodeOutline" type="checkbox"/> Nucleotide outline
                </label>
</li>
<li data-bind="css: {active: displayLinks}" role="presentation">
<label role="menuitem">
<input data-bind="checked: displayLinks" type="checkbox"/> Links
                </label>
</li>
<li data-bind="css: {active: displayPseudoknotLinks}" role="presentation">
<label role="menuitem">
<input data-bind="checked: displayPseudoknotLinks" type="checkbox"/> Pseudoknot Links
                </label>
</li>
<li data-bind="css: {active: displayProteinLinks}" role="presentation">
<label role="menuitem">
<input data-bind="checked: displayProteinLinks" type="checkbox"/> Protein Links
                </label>
</li>
<li class="divider" role="presentation"></li>
<li class="dropdown-header" role="presentation">Force Field Options</li>
<li class="form-group">
<label for="pseudoknotStrength" role="menuitem">Pseudoknot strength<br/>
<input class="slider form-control" data-bind="sliderValue: {value: pseudoknotStrength, min:0, max: 2, step: 0.1}" id="pseudoknotStrength" type="text">
</input></label>
</li>
<li class="form-group">
<label for="friction" role="menuitem">Force friction<br/>
<input class="slider form-control" data-bind="sliderValue: {value: friction, min:0, max: 100, step: 1}" id="friction" type="text">
</input></label>
<label for="charge" role="menuitem">Node Charge<br/>
<input class="slider form-control" data-bind="sliderValue: {value: charge, min:-80, max: 0, step: 1}" id="charge" type="text">
</input></label>
</li>
<li class="form-group">
<label for="friction" role="menuitem">Gravity<br/>
<input class="slider form-control" data-bind="sliderValue: {value: gravity, min:0, max: 1, step: 0.1}" id="gravity" type="text">
</input></label>
</li>
</ul>
</div>
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="top" data-toggle="tooltip" title="Fullscreen">
<button class="btn btn-default" onclick="toggleFullScreen('main'); return false;"><span class="glyphicon glyphicon-fullscreen"></span></button>
</div>
</div>
<div class="menu-right">
<div class="btn-group" data-delay='{"show":"800", "hide":"50"}' data-placement="top" data-toggle="tooltip" title="Share Link">
<button class="btn btn-default" data-bind="click: shareLink"><span class="glyphicon glyphicon-share-alt"></span></button>
</div>
<div class="btn-group dropup">
<button aria-expanded="false" class="btn btn-default dropdown-toggle" data-toggle="dropdown" type="button">
<span class="glyphicon glyphicon-download-alt"> </span>
<span class="caret"></span>
<span class="sr-only">Toggle Dropdown</span>
</button>
<ul class="dropdown-menu dropdown-menu-right menu-form" role="menu">
<!-- Dropdown menu links -->
<li data-bind="css: {active: background}" role="presentation">
<label role="menuitem">
<input data-bind="checked: background" type="checkbox"/> Background
                  </label>
</li>
<li class="divider" role="presentation"></li>
<li class="dropdown-header" role="presentation">Save as ...</li>
<li role="presentation"><a data-bind="click: saveSVG" download="rna.svg" role="menuitem">SVG</a></li>
<li role="presentation"><a data-bind="click: savePNG" download="rna.png" role="menuitem">PNG</a></li>
<li role="presentation"><a data-bind="click: saveJSON" download="rna.json" role="menuitem">JSON</a></li>
</ul>
</div>
</div>
</div>
<!-- fornac javascript -->
<script src="js/fornac.js" type="text/javascript"></script>
<!-- interface javascript -->
<script src="js/interface.js" type="text/javascript"></script>
</div>
</div>
<script>
(function(){
  // Minimal, layout-preserving GPU overlay using PixiJS v8
  let app = null;
  let layerEl = null;
  let pointContainer = null;
  let lastPts = null;
  let visible = false;

  function el(id){ return document.getElementById(id); }

  function ensureLayer(){
    if(layerEl) return layerEl;
    layerEl = el("gpu-layer");
    if(!layerEl) throw new Error("#gpu-layer não encontrado");
    return layerEl;
  }

  async function initPixi(){
    ensureLayer();
    if(app) return;
    app = new PIXI.Application();
    // Size from parent client rect; overlay will auto-resize via ResizeObserver
    const rect = layerEl.getBoundingClientRect();
    const w = Math.max(1, rect.width|0);
    const h = Math.max(1, rect.height|0);
    await app.init({ antialias:true, backgroundAlpha: 0, width:w, height:h });
    layerEl.innerHTML = "";
    layerEl.appendChild(app.canvas);

    // Resize observer to stay in sync with layout
    const ro = new ResizeObserver(()=>{
      const r = layerEl.getBoundingClientRect();
      const nw = Math.max(1, r.width|0);
      const nh = Math.max(1, r.height|0);
      app.renderer.resize(nw, nh);
      if(lastPts) fitStage(lastPts);
    });
    ro.observe(layerEl);
  }

  function finitePoints(raw){
    const pts=[]; if(!raw) return pts;
    for(const p of raw){
      if(!p) continue;
      const a = Array.isArray(p) ? p : [p.x, p.y];
      const x = +a[0], y = +a[1];
      if(Number.isFinite(x) && Number.isFinite(y)) pts.push([x,y]);
    }
    return pts;
  }

  function shapeToPoints(obj){
    if(!obj) return [];
    if(Array.isArray(obj)) return finitePoints(obj);
    if(Array.isArray(obj.x) && Array.isArray(obj.y)){
      const n = Math.min(obj.x.length, obj.y.length);
      const arr = new Array(n);
      for(let i=0;i<n;i++) arr[i] = [ +obj.x[i], +obj.y[i] ];
      return finitePoints(arr);
    }
    if(obj.data) return shapeToPoints(obj.data);
    if(Array.isArray(obj.positions)) return finitePoints(obj.positions);
    if(Array.isArray(obj.pts)) return finitePoints(obj.pts);
    if(Array.isArray(obj.coords)) return finitePoints(obj.coords);
    if(typeof obj.x === "number" && typeof obj.y === "number") return finitePoints([obj]);
    return [];
  }

  async function fetchPositions({seq, struct=null, chunk_size=3000}){
    const body = { header:"gpu", seq, chunk_size };
    if(struct) body.struct = struct;
    const res = await fetch("/struct_positions", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    const text = await res.text();
    if(!res.ok) throw new Error("Erro /struct_positions: " + text);
    let json = null;
    try{ json = JSON.parse(text); }
    catch(e){ throw new Error("Resposta não-JSON do servidor"); }
    const pts = shapeToPoints(json);
    return pts;
  }

  function fitStage(pts){
    if(!app) return;
    const xs = pts.map(p=>p[0]);
    const ys = pts.map(p=>p[1]);
    const minX = Math.min(...xs), maxX = Math.max(...xs);
    const minY = Math.min(...ys), maxY = Math.max(...ys);
    const pad = 20;
    const w = app.renderer.width, h = app.renderer.height;
    const spanX = Math.max(1e-6, maxX - minX);
    const spanY = Math.max(1e-6, maxY - minY);
    const s = Math.min((w - 2*pad)/spanX, (h - 2*pad)/spanY);
    app.stage.scale.set(s, s);
    app.stage.position.set(pad - minX * s, pad - minY * s);
  }

  async function renderGPU(points){
    await initPixi();
    const pts = finitePoints(points);
    if(pts.length === 0) return;
    app.stage.removeChildren();
    pointContainer = new PIXI.Container();
    app.stage.addChild(pointContainer);

    // DOT texture
    const g = new PIXI.Graphics();
    g.circle(0,0,1.8).fill(0xFFFFFF);
    const dotTex = app.renderer.generateTexture(g);

    // Add sprites
    for(const [x,y] of pts){
      const spr = new PIXI.Sprite(dotTex);
      spr.x = x; spr.y = y;
      pointContainer.addChild(spr);
    }
    lastPts = pts;
    fitStage(pts);
  }

  function cleanSeq(raw){
    if(!raw) return "";
    let s = raw.replace(/[^A-Za-z]/g, "").toUpperCase().replace(/T/g,"U");
    s = s.replace(/[^ACGUN]/g, "");
    return s;
  }
  function detectDotBracket(lines){
    for(const line of lines){
      const l=line.trim();
      if(l && /^[\.\(\)\[\]\{\}]+$/.test(l)) return l;
    }
    return null;
  }
  function parseInput(txt){
    if(!txt) throw new Error("Entrada vazia");
    const lines = txt.split(/\r?\n/).filter(l => l.trim().length && !/^>/.test(l.trim()));
    if(/^\s*[\{\[]/.test(txt)) throw new Error("Use o modo simples: SEQ + DOT-BRACKET");
    const struct = detectDotBracket(lines) || null;
    const seqRaw = lines.filter(l => !(l.trim() && /^[\.\(\)\[\]\{\}]+$/.test(l.trim()))).join("");
    const seq = cleanSeq(seqRaw);
    if(!seq) throw new Error("Campo 'seq' vazio após limpeza");
    if(struct && struct.length !== seq.length) return {seq, struct:null};
    return {seq, struct};
  }

  // Toggle overlay visibility without changing layout
  function setVisible(on){
    visible = !!on;
    const el = ensureLayer();
    el.style.display = visible ? "block" : "none";
  }
  // Keyboard toggle (doesn't change layout; optional discoverability)
  document.addEventListener("keydown", function(e){
    if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
    if(e.key === 'g' || e.key === 'G'){
      setVisible(!visible);
    }
  });

  // Hook into the existing "Submit" (Add Molecule) button to compute in parallel
  document.addEventListener("DOMContentLoaded", function(){
    const submit = el("Submit");
    if(submit){
      submit.addEventListener("click", async function(){
        try{
          const txt = (el("Input")?.value || el("JSONInput")?.value || el("ColorInput")?.value || "").trim();
          const {seq, struct} = parseInput(txt);
          const pts = await fetchPositions({seq, struct, chunk_size: 3000});
          await renderGPU(pts);
          setVisible(true); // auto-show overlay after success
        }catch(err){
          // silent: we não queremos modificar UX; apenas log
          console.warn("[GPU] falha opcional:", err.message);
        }
      }, {capture:false});
    }
    // Recentering when "Center molecules" is clicked (if exists)
    const centerBtn = Array.from(document.querySelectorAll("button.btn.btn-default"))
      .find(b => b.querySelector && b.querySelector(".glyphicon-screenshot"));
    if(centerBtn){
      centerBtn.addEventListener("click", function(){
        if(lastPts) fitStage(lastPts);
      });
    }
  });
})();
</script></body>
</html>
