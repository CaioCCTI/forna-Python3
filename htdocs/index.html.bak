<button class="btn btn-default" data-bind="click: cancelAddJSON" data-dismiss="modal" type="button">Cancel</button>
<button class="btn btn-primary" data-bind="click: submit" data-loading-text="Loading..." id="SubmitJSON" type="submit">Submit</button>
