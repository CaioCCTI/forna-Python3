<script src="js/bootstrap-slider.min.js" type="text/javascript"></script>
<!-- D3 -->
<script src="js/d3.js" type="text/javascript"></script>
<!-- File Saver https://github.com/eligrey/FileSaver.js -->
<script src="js/FileSaver.min.js" type="text/javascript"></script>
<!-- saveSvgAsPng.js -->
<script src="js/saveSvgAsPng.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/pixi.js@8.x/dist/pixi.min.js"></script></head>
<body>
<div id="main">
<!-- 'Add new molecule' modal -->
<div class="modal fade" id="add"> <!-- data-bind="showModal: loaded"-->
<div class="modal-dialog">
<div class="modal-content">
<div class="modal-header">
<button class="close" data-dismiss="modal" type="button"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
<h4 class="modal-title">Add RNA Molecule</h4>
</div>
<div class="modal-body">
<form role="form">
<div class="form-group">
<label for="Input">Sequence and Structure</label>
<div class="inner-addon right-addon">
<span aria-hidden="true" class="glyphicon glyphicon-remove inner-item inner-item-button" data-bind="click: function() { input(''); }"></span>
<textarea autofocus="" class="form-control" data-bind="value: input" id="Input" placeholder="" required="" rows="2" type="text"></textarea>
<span class="inner-item inner-item-bottom" data-bind="text: cursorPosition"></span>
</div>
</div><br/>
<div class="form-group">
<label for="inputFastaFile">And/Or load from File</label>
<div class="inner-addon left-addon" style="max-width:100%; overflow-x: hidden;">
<span aria-hidden="true" class="glyphicon glyphicon-remove inner-item inner-item-button" data-bind="click: function() { $('#inputFastaFile').val(''); inputFile(null); }, visible: inputFile"></span>
<input data-bind="event: { change: function() { inputFile($element.files[0]) }}" id="inputFastaFile" type="file"/>
<p class="help-block">Instead or in addition you may select a Fasta file.</p>
</div>
</div>
<div class="alert alert-danger" data-bind="visible: inputError().length &gt; 0, html: inputError" id="inputError" role="alert"> </div>
</form>
</div>
<div class="modal-footer">
<button class="btn btn-default" data-bind="click: cancelAddMolecule" data-dismiss="modal" type="button">Cancel</button>
<button class="btn btn-primary" data-bind="click: submit" data-loading-text="Loading..." id="Submit" type="submit">Submit</button>
</div>
</div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
</div><!-- /.modal -->
<!-- 'Add from API modal -->
<div class="modal fade" id="addAPI"> <!-- data-bind="showModal: loaded"-->
<div class="modal-dialog">
<div class="modal-content">
<div class="modal-header">
<button class="close" data-dismiss="modal" type="button"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
<h4 class="modal-title">Add Molecule from API</h4>
</div>
<div class="modal-body">
<form role="form">
<span aria-hidden="true" class="glyphicon glyphicon-refresh glyphicon-refresh-animate" data-bind="visible: inputError().length === 0"></span>
<span data-bind="visible: inputError().length === 0">  Please wait while we are
            getting your molecule...</span>
<div class="alert alert-danger" data-bind="visible: inputError().length &gt; 0, html: inputError" id="inputError" role="alert"> </div>
</form>
</div>
<div class="modal-footer">
<button class="btn btn-default" data-bind="click: done" data-dismiss="modal" type="button">Cancel</button>
</div>
</div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
</div><!-- /.modal -->
<!-- 'Add new JSON molecule' modal -->
<div class="modal fade" id="addJSON"> <!-- data-bind="showModal: loaded"-->
<div class="modal-dialog">
<div class="modal-content">
<div class="modal-header">
<button class="close" data-dismiss="modal" type="button"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
<h4 class="modal-title">Add Molecule from JSON</h4>
</div>
<div class="modal-body">
<form role="form">
<div class="form-group">
<label for="JSONInput">JSON Text</label>
<div class="inner-addon right-addon">
<span aria-hidden="true" class="glyphicon glyphicon-remove inner-item inner-item-button" data-bind="click: function() { input(''); }"></span>
<textarea autofocus="" class="form-control" data-bind="value: input" id="JSONInput" placeholder="" required="" rows="2" type="text"></textarea>
<span class="inner-item inner-item-bottom" data-bind="text: cursorPosition"></span>
</div>
</div><br/>
<div class="form-group">
<label for="inputJSONFile">And/Or load from File</label>
<div class="inner-addon left-addon" style="max-width:100%; overflow-x: hidden;">
<span aria-hidden="true" class="glyphicon glyphicon-remove inner-item inner-item-button" data-bind="click: function() { $('#inputJSONFile').val(''); inputFile(null); }, visible: inputFile"></span>
<input data-bind="event: { change: function() { inputFile($element.files[0]) }}" id="inputJSONFile" type="file"/>
